# =============================================================================
# Git Ignore — Touchless Gesture Control HUD (COMP6826001)
# Ensures no virtual environments, huge raw datasets, sensitive user studies,
# checkpoints, or cache files are committed to GitHub.
# =============================================================================

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Cache & Compilations ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Pytest & Coverage ---
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# --- Raw Video Datasets & Heavy Extracted Tensors ---
# Full 20BN-Jester dataset contains ~40,000 video clips (several GBs)
data/raw_jester_subset/*
!data/raw_jester_subset/.gitkeep
data/interim_landmarks/*
!data/interim_landmarks/.gitkeep
data/processed_landmarks/*
!data/processed_landmarks/.gitkeep
*.npy
*.npz
!models/onnx/*_scaler.npz
*.tar.gz
*.zip
*.7z

# --- Model Checkpoints & Raw PyTorch Weights ---
# Raw training checkpoints (.pt) can be hundreds of megabytes
runs/**/*.pt
runs/**/*.pth
*.pt
*.pth
*.ckpt
*.bin
*.h5

# Keep metadata, CSV summaries and ONNX exports (< 5 MB) for ready-to-run demo
!models/onnx/*.onnx
!models/onnx/*.json
!models/onnx/*_scaler.npz

# --- Private, Credentials & Environment Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.json
credentials.json
.streamlit/secrets.toml

# --- User Study Privacy (Participant Responses) ---
# Protect human subject anonymity in compliance with PRD Section 6
results/user_study/*.csv
!results/user_study/.gitkeep

# --- IDEs, Editors & OS Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs & Temp ---
*.log
*.tmp
*.bak
*.swp
*.swo
